# Gemini (server side only - never expose this in the frontend).
# This is the only secret the service needs; GEMINI_API_KEY is also accepted.
# Leave it empty to run the deterministic offline graph.
GOOGLE_API_KEY=
# Current stable model (2.5 is retired December 2026)
GEMINI_MODEL=gemini-3.8-flash

# Retrieval models - rebuild the index (scripts/build_index.py) if EMBED_MODEL changes.
# Both download anonymously from the Hugging Face Hub: no token required.
EMBED_MODEL=ibm-granite/granite-embedding-small-english-r2
RERANK_MODEL=Alibaba-NLP/gte-reranker-modernbert-base

# auto (Gemini when a key exists), gemini (require it), offline (deterministic)
AGENT_LLM_MODE=auto

# Agent behaviour
AGENT_MAX_ROUNDS=2
RETRIEVAL_TOP_K=5
# Off by default: a cross-encoder costs roughly a minute per query on free CPU
ENABLE_RERANK=0
# Set to 1 to load the embedding model at boot (slower start, faster first query)
ENABLE_WARMUP=0

# Storage
DB_PATH=./data/minerakshak.db

# CORS: comma-separated origins, or * during local development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo login created on first boot (set SEED_DEMO=0 to disable)
SEED_DEMO=1
DEMO_EMAIL=demo@minerakshak.app
DEMO_PASSWORD=demo1234

# Feed cache
UPDATES_TTL_SECONDS=600

# Serving backend for the embedder. onnx = same Granite vectors without PyTorch
# (~350 MB process, fits a 512 MB free host); torch = the reference path used to
# build the index. The ONNX export is pinned so it cannot drift behind the index.
EMBED_BACKEND=onnx
EMBED_ONNX_REPO=keisuke-miyako/granite-embedding-small-english-r2-onnx-fp32
EMBED_ONNX_FILE=model.onnx
EMBED_ONNX_REVISION=5f8b507347bf281bcaceefcc51ae5435a31fbbdd
# Threads for the encoder; free hosts give a fraction of a core
TORCH_THREADS=1
