# Gemini (server side only - never expose this in the frontend)
GOOGLE_API_KEY=
# Current stable model (2.5 is retired December 2026)
GEMINI_MODEL=gemini-3.8-flash

# Retrieval models - rebuild the index (scripts/build_index.py) if EMBED_MODEL changes
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B

# auto (Gemini when a key exists), gemini (require it), offline (deterministic)
AGENT_LLM_MODE=auto

# Agent behaviour
AGENT_MAX_ROUNDS=2
RETRIEVAL_TOP_K=5
ENABLE_RERANK=1
# Set to 1 to load the embedding model at boot (slower start, faster first query)
ENABLE_WARMUP=0

# Storage
DB_PATH=./data/minerakshak.db

# CORS: comma-separated origins, or * during local development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demo login created on first boot (set SEED_DEMO=0 to disable)
SEED_DEMO=1
DEMO_EMAIL=demo@minerakshak.app
DEMO_PASSWORD=demo1234

# Feed cache
UPDATES_TTL_SECONDS=600
